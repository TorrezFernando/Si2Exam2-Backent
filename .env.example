ENVIRONMENT=development
DATABASE_URL=postgresql://fashionstore:CHANGE_ME@localhost:5432/fashionstore
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
BACKEND_CORS_ORIGINS=["https://YOUR_DOMAIN"]
PUBLIC_API_URL=https://YOUR_DOMAIN
PUBLIC_WEB_URL=https://YOUR_DOMAIN
# Obtain the test appkey from Libelula; do not use a real-money key for the exam.
LIBELULA_TEST_APPKEY=
# PayPal sandbox app (developer.paypal.com > Apps & Credentials). When set, online orders use PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_BOB_PER_USD=6.96
GEMINI_API_KEY_1=
GEMINI_MODEL=
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=
# Modelo de texto para reportes. Si está vacío, analytics usa gemini-3.5-flash.
GEMINI_TEXT_MODEL=
